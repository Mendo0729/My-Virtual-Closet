# AI keys are used only by the server-side proxy.
# Never expose these keys as VITE_* variables.

# Development primary: Qwen 3.7 Flash through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash

# Development fallback and current production model.
# Keep using the same Gemini project/key that is on the free tier if you want
# fallback requests to remain within Google's free-tier limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
